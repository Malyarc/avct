{
  "name": "avct",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Tzu Chi Advanced Certification Training (AVCT) \u2014 application portal for TCCA (Tzu Ching) alumni",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "db:migrate": "node scripts/migrate.mjs",
    "verify": "npm run typecheck && npm run test && npm run build",
    "audit": "node scripts/audit-layout.mjs",
    "shots": "node scripts/screenshots.mjs",
    "form:extract": "node scripts/extract-form-text.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "html2canvas-pro": "^2.4.0",
    "jspdf": "^4.2.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@netlify/functions": "^6.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^26.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^4.1.11",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
