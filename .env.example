# Copy to .env for local development, and set the same values in
# Netlify -> Site configuration -> Environment variables.

# Neon Postgres pooled connection string.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Admin access code for /admin. Defaults to 0314 when unset.
ADMIN_PASSWORD="0314"

# HMAC key for the admin session cookie. Use a long random string in production.
SESSION_SECRET="change-me"
